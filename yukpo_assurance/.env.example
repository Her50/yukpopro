# ═══════════════════════════════════════════════════════════════════════════════
# YukpoAssurance — Variables d'environnement (COMPLET)
# Copier ce fichier en .env et remplir TOUTES les valeurs avant démarrage.
# Ne jamais committer le fichier .env — il est dans .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=YukpoAssurance
APP_VERSION=1.0.0
DEBUG=false

# SECRET_KEY : Clé JWT. Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# En production : utiliser un vault (AWS Secrets Manager, HashiCorp Vault)
SECRET_KEY=CHANGER_CLE_JWT_MIN_32_CHARS_EN_PRODUCTION

# SIGNATURE_HMAC_KEY : Clé HMAC pour la signature électronique de documents
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SIGNATURE_HMAC_KEY=CHANGER_CLE_HMAC_SIGNATURE_MIN_32_CHARS

# ── IA — Clés API ─────────────────────────────────────────────────────────────
# Anthropic Claude (requis — modèle primaire)
CLAUDE_API_KEY=sk-ant-api03-VOTRE_CLE_CLAUDE

# OpenAI GPT-4o (requis — fallback + Vision dual-check)
OPENAI_API_KEY=sk-VOTRE_CLE_OPENAI

# Modèles IA (valeurs par défaut recommandées)
CLAUDE_MODEL_PRIMAIRE=claude-opus-4-6
CLAUDE_MODEL_RAPIDE=claude-haiku-4-5-20251001
GPT_MODEL_FALLBACK=gpt-4o

# Paramètres de performance IA
IA_MAX_TOKENS=16384
IA_MAX_TOKENS_DOCUMENT=32768
IA_CONFIDENCE_THRESHOLD=0.85
IA_MAX_RETRIES=3
IA_TIMEOUT_SECONDS=120
IA_TEMPERATURE_PRECISION=0.1
IA_TEMPERATURE_REDACTION=0.4
IA_TEMPERATURE_CREATIVE=0.7

# ── Base de données ───────────────────────────────────────────────────────────
# Développement : SQLite (pas de serveur requis)
DATABASE_URL=sqlite+aiosqlite:///./yukpo_assurance.db

# Production : PostgreSQL avec asyncpg
# DATABASE_URL=postgresql+asyncpg://yukpo_user:VOTRE_PASSWORD_DB@db:5432/yukpo_assurance
DATABASE_POOL_SIZE=10

# ── Sécurité PostgreSQL (Docker uniquement) ───────────────────────────────────
# Mots de passe obligatoires en production — ne jamais utiliser les valeurs par défaut
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_POSTGRES_MIN_16_CHARS
POSTGRES_READONLY_PASSWORD=CHANGER_MOT_DE_PASSE_READONLY_MIN_16_CHARS

# ── Redis (cache IA + sessions + rate limiting) ───────────────────────────────
# Mot de passe Redis obligatoire en production
REDIS_PASSWORD=CHANGER_MOT_DE_PASSE_REDIS_MIN_16_CHARS
# URL avec authentification (docker: redis://:$REDIS_PASSWORD@redis:6379/0)
REDIS_URL=redis://:CHANGER_MOT_DE_PASSE_REDIS_MIN_16_CHARS@redis:6379/0
CACHE_TTL_SECONDS=3600

# ── ORASS / Mercure (ERP assurance) ──────────────────────────────────────────
# Mode : "simulation" | "direct_sql" | "csv_import" | "api"
ORASS_MODE=simulation

# Direct SQL (production) :
# ORASS_DSN=postgresql://orass_user:PASSWORD@orass-server:5432/orass_prod
# ORASS_DB_URL=postgresql://orass_user:PASSWORD@orass-server:5432/orass_prod

# API REST (si ORASS expose une API) :
# ORASS_API_URL=https://orass.compagnie.cm/api/v1

# Export CSV (mode intermédiaire) :
ORASS_CSV_DIR=data/orass_csv

# Mercure :
# MERCURE_DB_URL=postgresql://mercure_user:PASSWORD@mercure-server:5432/mercure_prod

# ── Sécurité API ──────────────────────────────────────────────────────────────
# Origines CORS autorisées (frontend + apps mobiles)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","https://app.yukpo-assurance.cm"]

# Durée de validité des tokens JWT
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Multi-tenancy : mettre True en production
ENFORCE_COMPAGNIE_ISOLATION=false

# ── WhatsApp Business (Meta Cloud API) ───────────────────────────────────────
# Obtenir depuis Meta for Developers → votre app → WhatsApp
META_WHATSAPP_APP_SECRET=VOTRE_APP_SECRET_META
META_WHATSAPP_VERIFY_TOKEN=VOTRE_TOKEN_VERIFICATION_WEBHOOK
META_WHATSAPP_PHONE_ID=VOTRE_PHONE_NUMBER_ID
META_WHATSAPP_TOKEN=VOTRE_ACCESS_TOKEN_META_PERMANENT

# ── Paiement Mobile Money ─────────────────────────────────────────────────────
# CinetPay (Cameroun, Côte d'Ivoire, Sénégal, etc.)
CINETPAY_API_KEY=VOTRE_CLE_CINETPAY
CINETPAY_SITE_ID=VOTRE_SITE_ID_CINETPAY

# MTN Mobile Money
MTN_MOMO_API_KEY=VOTRE_CLE_MTN_MOMO
MTN_MOMO_SUBSCRIPTION_KEY=VOTRE_SUBSCRIPTION_KEY_MTN
MTN_MOMO_ENVIRONMENT=sandbox    # "sandbox" | "production"

# Orange Money
ORANGE_MONEY_CLIENT_ID=VOTRE_CLIENT_ID_ORANGE
ORANGE_MONEY_CLIENT_SECRET=VOTRE_CLIENT_SECRET_ORANGE
ORANGE_MONEY_MERCHANT_KEY=VOTRE_MERCHANT_KEY_ORANGE

# Wave
WAVE_API_KEY=VOTRE_CLE_WAVE

# ── Facebook / Instagram (Community Manager) ─────────────────────────────────
META_FB_APP_ID=VOTRE_FB_APP_ID
META_FB_APP_SECRET=VOTRE_FB_APP_SECRET
META_FB_PAGE_ACCESS_TOKEN=VOTRE_PAGE_ACCESS_TOKEN
META_FB_PAGE_ID=VOTRE_PAGE_ID
META_IG_USER_ID=VOTRE_IG_USER_ID
META_GRAPH_API_VERSION=v19.0

# ── Veille Tendances (TrendPulse) ─────────────────────────────────────────────
SERPAPI_KEY=VOTRE_CLE_SERPAPI
YOUTUBE_API_KEY=VOTRE_CLE_YOUTUBE_API
NEWSAPI_KEY=VOTRE_CLE_NEWSAPI
REDDIT_CLIENT_ID=VOTRE_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=VOTRE_REDDIT_CLIENT_SECRET

# ── Veille Emploi — APIs jobboards réels ─────────────────────────────────────
# SERPAPI_KEY (ci-dessus) = source principale Google Jobs (LinkedIn, Indeed, Glassdoor, sites locaux)
# Adzuna : gratuit 250 req/mois, couvre UK/FR/CA/ZA/international
#   Obtenir : https://developer.adzuna.com/
ADZUNA_APP_ID=VOTRE_ADZUNA_APP_ID
ADZUNA_APP_KEY=VOTRE_ADZUNA_APP_KEY
# Jooble : agrégateur international avec bonne couverture Afrique
#   Obtenir : https://jooble.org/api/about
JOOBLE_API_KEY=VOTRE_JOOBLE_API_KEY

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.VOTRE_CLE_SENDGRID
SENDGRID_FROM_EMAIL=noreply@yukpo-assurance.cm
SENDGRID_FROM_NAME=YukpoAssurance

# ── SMTP (email transactionnel) ───────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.VOTRE_CLE_SENDGRID
SMTP_FROM=noreply@yukpo-assurance.cm

# ── Twilio (WhatsApp legacy — remplacé par Meta Cloud API) ───────────────────
# TWILIO_ACCOUNT_SID=ACXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Fichiers et stockage ──────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MAX_PDF_SIZE_MB=20
MAX_EXCEL_SIZE_MB=5
CONTRATS_DIR=data/contrats_generes
GENERATED_DOCS_DIR=data/generated

# ── Signature Électronique ───────────────────────────────────────────────────
# Backend : "hmac" (interne) | "pki_local" (auto-signée) | "yousign" | "docusign"
SIGNATURE_BACKEND=hmac

# Yousign (signature qualifiée eIDAS — recommandé zone CIMA)
# Obtenir depuis : https://yousign.com/fr-fr/api-signature-electronique
YOUSIGN_API_KEY=VOTRE_CLE_YOUSIGN
YOUSIGN_BASE_URL=https://staging-api.yousign.app/v3

# Docusign (alternative internationale)
# DOCUSIGN_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# DOCUSIGN_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# DOCUSIGN_RSA_KEY_PATH=data/pki/docusign_rsa.key
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# PKI auto-signée (tests/recette — générer avec scripts/setup_pki_signature.py)
# PKI_CA_CERT_PATH=data/pki/ca.cert.pem
# PKI_SIGNING_KEY_PATH=data/pki/signing.key.pem
# PKI_SIGNING_CERT_PATH=data/pki/signing.cert.pem

# ── OpenTelemetry (tracing distribué) ────────────────────────────────────────
# Activer en production avec Jaeger ou Grafana Tempo
OTLP_ENABLED=false
OTLP_ENDPOINT=http://jaeger:4317      # ou http://tempo:4317 pour Grafana

# ── Sécurité PII — Chiffrement AES-256-GCM ───────────────────────────────────
# Requis pour chiffrer CNI, téléphone, email dans les logs et la BD
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
PII_ENCRYPTION_KEY=CHANGER_CLE_AES256_MIN_32_CHARS_EN_PRODUCTION

# ── Budget IA (contrôle des coûts API) ───────────────────────────────────────
# Budget global journalier en USD (hard limit — bloque les appels si dépassé)
IA_BUDGET_GLOBAL_USD_JOUR=50.0
# Seuil d'alerte (80% du budget → warning dans les logs)
IA_BUDGET_ALERTE_USD=40.0
# Budget par utilisateur par jour (USD)
IA_BUDGET_PAR_USER_USD_JOUR=5.0

# ── ORASS API (si mode api activé) ───────────────────────────────────────────
# ORASS_API_KEY=VOTRE_CLE_API_ORASS
# ORASS_API_SECRET=VOTRE_SECRET_HMAC_ORASS_MIN_32_CHARS

# ── Monitoring Grafana ────────────────────────────────────────────────────────
# Mot de passe admin Grafana (OBLIGATOIRE — changer la valeur par défaut)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(20))"
GRAFANA_PASSWORD=CHANGER_MOT_DE_PASSE_GRAFANA_MIN_16_CHARS

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json      # "json" (prod) | "text" (dev)

# ── Super Admin Yukpo ─────────────────────────────────────────────────────────
# Utilisé par POST /api/v1/auth/setup-yukpo pour créer le premier compte proprietaire
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT : Vider cette variable après la création du compte en production
SETUP_YUKPO_SECRET=CHANGER_CE_SECRET_AVANT_UTILISATION
SUPER_ADMIN_EMAIL=dg@yukpo.cm

# ── RAG Multi-documents (Corpus réglementaire africain) ───────────────────────
# Webhook pour notifier les mises à jour RAG (Slack, Teams, n8n, Make…)
# Format Slack : https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ
RAG_WEBHOOK_URL=

# Email d'alerte pour les échecs critiques de mise à jour RAG
RAG_ALERT_EMAIL=admin@yukpo.cm
