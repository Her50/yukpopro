{
  "expo": {
    "name": "YukpoSecrétariat",
    "slug": "yukposecretariat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "yukposecretariat",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1d4ed8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yukpo.secretariat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8"
      },
      "package": "com.yukpo.secretariat",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Autoriser YukpoSecrétariat à utiliser l'appareil photo pour scanner des documents." }
      ],
      [
        "expo-av",
        { "microphonePermission": "Autoriser YukpoSecrétariat à utiliser le microphone pour dicter des textes." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
